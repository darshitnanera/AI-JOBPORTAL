PORT=5000
NODE_ENV=development
# Comma-separated list of allowed CORS origins for browser requests (add your Vercel domains and localhost)
# Example:
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-frontend.vercel.app,https://your-admin.vercel.app
CORS_ORIGINS=
