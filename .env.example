# Database & Authentication
MONGO_URI=mongodb://localhost:27017/qdc-job-portal
JWT_SECRET=your-secret-key-for-jwt-change-in-production

# Cloudinary Configuration
CLOUDINARY_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET_KEY=your-cloudinary-secret-key

# Email Configuration (Brevo)
EMAIL_USER=your-email-address
BREVO_API_KEY=your-brevo-api-key

# PRIMARY AI PROVIDER — CURRENTLY USED BY THE APPLICATION
ANTHROPIC_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-3-5-sonnet-20240620
CLAUDE_API_KEY=your-claude-api-key

# SECONDARY AI PROVIDER — AVAILABLE FOR FUTURE USE
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# AI provider currently used by the application
AI_PROVIDER=claude

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
