# Backend API origin — no trailing slash, no /api suffix.
# Call sites build their own paths as `${VITE_API_URL}/api/...`.
#
# Local development:  http://localhost:5000
# Production:         https://ai-jobportal-backend.onrender.com
#
# Both names must be set — different modules in this codebase read each one.
VITE_API_URL=https://ai-jobportal-backend.onrender.com
VITE_API_BASE_URL=https://ai-jobportal-backend.onrender.com
